{
  "name": "@liquyn/sdk",
  "version": "0.1.0",
  "description": "TypeScript client, ABIs, RFQ signing and loan math for Liquyn's fixed-term markets on HyperEVM.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "node scripts/check.ts",
    "check:terms": "node scripts/check-terms.ts"
  },
  "peerDependencies": {
    "viem": "^2.30.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "viem": "2.55.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kylebolton/liquyn-sdk.git"
  },
  "homepage": "https://www.liquyn.com/developers"
}
